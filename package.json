{
    "name":  "dsh-reze-render",
    "version":  "0.1.1",
    "description":  "用 reze-engine 离线出 MMD 视频/静帧：资产自检 + 机位试片 + 出片（无头 Chrome WebGPU 逐帧渲染 + ffmpeg 编码 + 判据验收）",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./package.json":  "./package.json"
                },
    "files": [
                  "lib",
                  "README.md",
                  "dsh-plugin.json"
    ],
    "license":  "MIT",
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.1",
                             "@deepseek-ai/schemastery":  "^3.18.1-rc.1",
                             "@deepseek-ai/dsh-tools":  "^0.1.0-rc.6"
                         },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.9.3"
                        },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit"
                }
}
